<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Cadastro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style> body { background-color: #fff3cd; } /* Fundo amarelado para indicar Edição */ </style>
</head>
<body>
    <div class="container mt-4 mb-5">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark fw-bold">
                ✏️ EDITANDO: <%= paciente.nome %>
            </div>
            <div class="card-body">
                <form action="/editar/<%= paciente.id %>" method="POST">
                    
                    <h6 class="text-secondary border-bottom pb-2">Identificação</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label>CPF</label>
                            <input type="text" name="cpf" class="form-control" value="<%= paciente.cpf %>">
                        </div>
                        <div class="col-md-3">
                            <label>CNS</label>
                            <input type="text" name="cns" class="form-control" value="<%= paciente.cns %>">
                        </div>
                        <div class="col-md-6">
                            <label>Nome Completo</label>
                            <input type="text" name="nome" class="form-control" value="<%= paciente.nome %>" required>
                        </div>
                        <div class="col-md-3">
                            <label>Data Nascimento</label>
                            <input type="date" name="dataNascimento" class="form-control" value="<%= paciente.dataNascimento %>" required>
                        </div>
                        <div class="col-md-3">
                            <label>Sexo</label>
                            <select name="sexo" class="form-select">
                                <option value="Masculino" <%= paciente.sexo == 'Masculino' ? 'selected' : '' %>>Masculino</option>
                                <option value="Feminino" <%= paciente.sexo == 'Feminino' ? 'selected' : '' %>>Feminino</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Raça/Cor</label>
                            <select name="racaCor" class="form-select">
                                <option value="Parda" <%= paciente.racaCor == 'Parda' ? 'selected' : '' %>>Parda</option>
                                <option value="Branca" <%= paciente.racaCor == 'Branca' ? 'selected' : '' %>>Branca</option>
                                <option value="Preta" <%= paciente.racaCor == 'Preta' ? 'selected' : '' %>>Preta</option>
                                <option value="Amarela" <%= paciente.racaCor == 'Amarela' ? 'selected' : '' %>>Amarela</option>
                                <option value="Indígena" <%= paciente.racaCor == 'Indígena' ? 'selected' : '' %>>Indígena</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label>Telefone</label>
                            <input type="text" name="telefone" class="form-control" value="<%= paciente.telefone %>">
                        </div>
                        <div class="col-md-6">
                            <label>Nome da Mãe</label>
                            <input type="text" name="nomeMae" class="form-control" value="<%= paciente.nomeMae %>">
                        </div>
                         <div class="col-md-6">
                            <label>Nome Social</label>
                            <input type="text" name="nomeSocial" class="form-control" value="<%= paciente.nomeSocial %>">
                        </div>
                    </div>

                    <h6 class="text-secondary border-bottom pb-2 mt-4">Localização</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-2">
                            <label>Microárea</label>
                            <input type="text" name="microarea" class="form-control" value="<%= paciente.microarea %>" required>
                        </div>
                        <div class="col-md-2">
                            <label>Nº Família</label>
                            <input type="text" name="familiaId" class="form-control" value="<%= paciente.familiaId %>">
                        </div>
                        <div class="col-md-6">
                            <label>Endereço</label>
                            <input type="text" name="endereco" class="form-control" value="<%= paciente.endereco %>" required>
                        </div>
                        <div class="col-md-2">
                            <label>Número</label>
                            <input type="text" name="numero" class="form-control" value="<%= paciente.numero %>">
                        </div>
                         <div class="col-md-6">
                            <label>Bairro</label>
                            <input type="text" name="bairro" class="form-control" value="<%= paciente.bairro %>">
                        </div>
                        <div class="col-md-6">
                            <label>CEP</label>
                            <input type="text" name="cep" class="form-control" value="<%= paciente.cep %>">
                        </div>
                    </div>
                    
                    <h6 class="text-secondary border-bottom pb-2 mt-4">Social / Trabalho</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label>Ocupação</label>
                            <input type="text" name="ocupacao" class="form-control" value="<%= paciente.ocupacao %>">
                        </div>
                         <div class="col-md-4">
                            <label>Escolaridade</label>
                            <select name="escolaridade" class="form-select">
                                <option value="<%= paciente.escolaridade %>" selected><%= paciente.escolaridade %></option>
                                <% ['Creche', 'Fundamental Incompleto', 'Fundamental Completo', 'Médio Incompleto', 'Médio Completo', 'Superior Completo', 'Não Alfabetizado'].forEach(opcao => { %>
                                    <option value="<%= opcao %>"><%= opcao %></option>
                                <% }); %>
                                </select>
                        </div>
                        <div class="col-md-4 pt-4">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="beneficiarioBolsaFamilia" <%= paciente.beneficiarioBolsaFamilia ? 'checked' : '' %>>
                                <label>Bolsa Família</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <% const adicionais = {
                            nacionalidade: { nome: 'Nacionalidade', opcoes: ['Brasileira', 'Naturalizado', 'Estrangeiro'] },
                            situacaoTrabalho: { nome: 'Situação no Mercado de Trabalho', opcoes: ['Assalariado C/ Carteira', 'Assalariado S/ Carteira', 'Autônomo', 'Desempregado', 'Aposentado', 'Dona de Casa'] },
                            peso: { nome: 'Situação de Peso (Auto-referida)', opcoes: ['Abaixo do Peso', 'Peso Adequado', 'Sobrepeso', 'Obesidade'] }
                        }; %>
                        <% Object.entries(adicionais).forEach(([campo, config]) => { %>
                            <div class="col-md-4">
                                <label for="<%= campo %>" class="form-label"><%= config.nome %></label>
                                <select id="<%= campo %>" name="<%= campo %>" class="form-select">
                                    <option value="">Selecione...</option>
                                    <% if (paciente[campo] && !config.opcoes.includes(paciente[campo])) { %>
                                        <option value="<%= paciente[campo] %>" selected><%= paciente[campo] %></option>
                                    <% } %>
                                    <% config.opcoes.forEach(opcao => { %>
                                        <option value="<%= opcao %>" <%= paciente[campo] === opcao ? 'selected' : '' %>><%= opcao %></option>
                                    <% }); %>
                                </select>
                            </div>
                        <% }); %>
                    </div>

                    <h6 class="text-secondary border-bottom pb-2 mt-4">Condições de Saúde</h6>
                    <div class="row g-2">
                        <div class="col-md-3"><input type="checkbox" name="hipertenso" <%= paciente.hipertenso ? 'checked' : '' %>> Hipertensão</div>
                        <div class="col-md-3"><input type="checkbox" name="diabetico" <%= paciente.diabetico ? 'checked' : '' %>> Diabetes</div>
                        <div class="col-md-3"><input type="checkbox" name="gestante" <%= paciente.gestante ? 'checked' : '' %>> Gestante</div>
                        <div class="col-md-3"><input type="checkbox" name="acamado" <%= paciente.acamado ? 'checked' : '' %>> Acamado</div>
                        
                        <div class="col-md-3"><input type="checkbox" name="fumante" <%= paciente.fumante ? 'checked' : '' %>> Fumante</div>
                        <div class="col-md-3"><input type="checkbox" name="alcool" <%= paciente.alcool ? 'checked' : '' %>> Álcool</div>
                        <div class="col-md-3"><input type="checkbox" name="respiratoria" <%= paciente.respiratoria ? 'checked' : '' %>> Respiratória</div>
                        <div class="col-md-3"><input type="checkbox" name="cardiaco" <%= paciente.cardiaco ? 'checked' : '' %>> Cardíaco</div>
                    </div>

                    <div class="row g-2 mt-2">
                        <% const marcadores = {
                            temPlanoSaude: 'Plano de saúde', drogas: 'Uso de outras drogas', domiciliado: 'Domiciliado',
                            avc: 'Teve AVC / Derrame', infarto: 'Teve infarto', rim: 'Problemas nos rins',
                            hanseniase: 'Hanseníase', tuberculose: 'Tuberculose', cancer: 'Câncer',
                            internacaoRecente: 'Internado nos últimos 12 meses', saudeMental: 'Problema de saúde mental'
                        }; %>
                        <% Object.entries(marcadores).forEach(([campo, nome]) => { %>
                            <div class="col-md-4 form-check">
                                <input type="checkbox" id="<%= campo %>" name="<%= campo %>" class="form-check-input" <%= paciente[campo] ? 'checked' : '' %>>
                                <label for="<%= campo %>" class="form-check-label"><%= nome %></label>
                            </div>
                        <% }); %>
                    </div>
                    <div class="mb-3 mt-4">
                        <label>Observações</label>
                        <textarea name="observacoes" class="form-control" rows="3"><%= paciente.observacoes %></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg">💾 Salvar Alterações</button>
                        <a href="/paciente/<%= paciente.id %>" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
