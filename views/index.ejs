<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel ACS Digital</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .card-paciente { transition: transform 0.2s; border-left: 5px solid #0d6efd; }
        .card-paciente:hover { transform: translateY(-5px); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .badge-microarea { font-size: 0.9em; background-color: #e9ecef; color: #333; padding: 5px 10px; border-radius: 10px; }
        .tag-alerta { font-size: 0.7em; margin-right: 2px; }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🏥 ACS Digital</a>
            <div class="d-flex">
                <a href="/cadastro" class="btn btn-light text-primary fw-bold shadow-sm">+ NOVO CADASTRO</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="alert alert-info">Estratificação registrada pela equipe, conforme o protocolo informado. Pacientes sem avaliação permanecem como “não avaliados”.</div>
        <div class="row g-3 mb-4">
            <% for (const [titulo, valor] of [['Pacientes', resumo.total], ['Avaliados', resumo.avaliados], ['Não avaliados', resumo.naoAvaliados], ['Reavaliação vencida', resumo.atrasados]]) { %>
                <div class="col-6 col-lg-3"><div class="card p-3 h-100"><span class="text-muted"><%= titulo %></span><strong class="fs-3"><%= valor %></strong></div></div>
            <% } %>
        </div>
        <p class="small text-muted">Os contadores consideram todos os pacientes e o tipo de avaliação selecionado. Os demais filtros se aplicam à lista abaixo.</p>
        <form action="/" method="GET" class="card p-3 mb-4">
            <div class="row g-3">
                <div class="col-lg-4">
                    <label for="search" class="form-label">Buscar paciente</label>
                    <input id="search" type="text" name="search" value="<%= filtros.search %>" class="form-control" placeholder="Nome, CPF, CNS, microárea ou família">
                </div>
                <div class="col-lg-3">
                    <label for="tipo" class="form-label">Tipo de avaliação</label>
                    <select id="tipo" name="tipo" class="form-select">
                        <option value="">Todos os tipos</option>
                        <% Object.entries(risco.tipos).forEach(([chave, nome]) => { %><option value="<%= chave %>" <%= filtros.tipo === chave ? 'selected' : '' %>><%= nome %></option><% }); %>
                    </select>
                </div>
                <div class="col-lg-2">
                    <label for="nivel" class="form-label">Classificação</label>
                    <select id="nivel" name="nivel" class="form-select">
                        <option value="">Todas</option>
                        <option value="nao_avaliado" <%= filtros.nivel === 'nao_avaliado' ? 'selected' : '' %>>Não avaliado</option>
                        <% Object.entries(risco.niveis).forEach(([chave, nivel]) => { %><option value="<%= chave %>" <%= filtros.nivel === chave ? 'selected' : '' %>><%= nivel.nome %></option><% }); %>
                    </select>
                </div>
                <div class="col-lg-3">
                    <label for="acompanhamento" class="form-label">Reavaliação</label>
                    <select id="acompanhamento" name="acompanhamento" class="form-select">
                        <option value="">Todas</option>
                        <option value="atrasada" <%= filtros.acompanhamento === 'atrasada' ? 'selected' : '' %>>Prazo vencido</option>
                        <option value="hoje" <%= filtros.acompanhamento === 'hoje' ? 'selected' : '' %>>Hoje</option>
                        <option value="sem_data" <%= filtros.acompanhamento === 'sem_data' ? 'selected' : '' %>>Sem data definida</option>
                    </select>
                </div>
                <div class="col-12 d-flex gap-2"><button class="btn btn-primary" type="submit">Filtrar</button><a href="/" class="btn btn-outline-secondary">Limpar filtros</a></div>
            </div>
        </form>
        <p class="text-muted small"><%= pacientes.length %> paciente(s) encontrado(s). As classificações de diferentes tipos não são somadas.</p>

        <h4 class="mb-3 text-secondary border-bottom pb-2">📂 Meus Cadastros</h4>

        <div class="row">
            <% if(pacientes && pacientes.length > 0) { %>
                <% pacientes.forEach(function(paciente) { %>
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card card-paciente h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge-microarea">MA: <%= paciente.microarea %></span>
                                    <small class="text-muted">Fam: <%= paciente.familiaId || '-' %></small>
                                </div>
                                
                                <h5 class="card-title fw-bold text-primary mb-1 text-truncate"><%= paciente.nome %></h5>
                                <p class="card-text text-muted small mb-2">
                                    CNS: <%= paciente.cns || '...' %>
                                </p>

                                <div class="mb-3">
                                    <% if(paciente.gestante) { %> <span class="badge bg-danger tag-alerta">Gestante</span> <% } %>
                                    <% if(paciente.hipertenso) { %> <span class="badge bg-warning text-dark tag-alerta">Hipertenso</span> <% } %>
                                    <% if(paciente.diabetico) { %> <span class="badge bg-warning text-dark tag-alerta">Diabético</span> <% } %>
                                    <% if(paciente.acamado) { %> <span class="badge bg-dark tag-alerta">Acamado</span> <% } %>
                                    <% if(paciente.beneficiarioBolsaFamilia) { %> <span class="badge bg-success tag-alerta">Bolsa Família</span> <% } %>
                                </div>

                                <%- include('partials/resumo-risco', { paciente }) %>
                                <a href="/paciente/<%= paciente.id %>/risco" class="btn btn-primary w-100 btn-sm fw-bold mb-2">Estratificação de risco</a>
                                <a href="/paciente/<%= paciente.id %>" class="btn btn-outline-primary w-100 btn-sm fw-bold">Ver Ficha / Editar</a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center mt-5">
                    <h3 class="text-muted">Nenhum paciente encontrado.</h3>
                    <a href="/cadastro" class="btn btn-lg btn-success mt-3">Cadastrar o Primeiro</a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
